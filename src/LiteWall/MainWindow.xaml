<Window x:Class="LiteWall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiteWall - Low-End Live Wallpaper Engine" Height="480" Width="680"
        Background="#121216" Foreground="White" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="135"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="LiteWall" FontSize="24" FontWeight="Bold" Foreground="#60A5FA"/>
                <TextBlock Text="Ultra-lightweight desktop engine • Auto-pauses in fullscreen" FontSize="12" Foreground="#9CA3AF"/>
            </StackPanel>

            <Button x:Name="CopyPromptBtn" Content="✨ Copy AI Prompt" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="12,8" Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand" Click="CopyPromptBtn_Click"/>
        </Grid>

        <!-- Drag & Drop Zone -->
        <Border Grid.Row="1" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                MouseLeftButtonUp="DropZone_Click" Cursor="Hand"
                Background="#1E1E24" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Drop ANY file here or click to browse" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Supports .HTML (AI-Generated / Interactive), .MP4 / .WEBM (Video), .GIF / .PNG / .JPG" 
                           FontSize="12" Foreground="#9CA3AF" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Pre-Built Wallpapers" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,10"/>

        <!-- Pre-built Wallpaper Gallery -->
        <ListBox x:Name="PrebuiltList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 SelectionChanged="PrebuiltList_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="190" Height="95" Margin="0,0,12,12" Background="#1E1E24" 
                            CornerRadius="8" Padding="12" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#60A5FA" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
